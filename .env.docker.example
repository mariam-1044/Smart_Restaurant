# Copy to .env (same dir as docker-compose.yml) and fill in.
# docker-compose reads this file automatically.

# Required — used to sign JWTs. Generate one: `openssl rand -hex 32`
JWT_SECRET=change-me-generate-a-random-string

# AI provider (recipe generation, endorsements).
# OPENAI_API_KEY holds the API key for whichever provider AI_BASE_URL targets.
#
# For OpenAI: leave AI_BASE_URL/AI_MODEL blank (defaults to gpt-4o), set an sk-... key.
# For Google Gemini (OpenAI-compatible endpoint): use the values below and a Google AI Studio key (AIza...).
OPENAI_API_KEY=your-ai-provider-api-key
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
AI_MODEL=gemini-2.5-pro

# RAG recipe generation (Python ML service: Qdrant vector store + Google Gemini).
# Recipe generation now retrieves real recipes from Qdrant and composes with Gemini.
GOOGLE_API_KEY=your-google-ai-studio-api-key
QDRANT_URL="https://your-cluster-id.region.gcp.cloud.qdrant.io:6333"
QDRANT_API_KEY="your-qdrant-api-key"
QDRANT_COLLECTION_NAME="recipes_nlg"
# Query embeddings MUST match the model the Qdrant collection was built with.
# The recipes_nlg / restaurant_recipes collections are 384-dim MiniLM, so use
# the local HuggingFace model (no API key needed) and a low score threshold.
RAG_EMBEDDING_PROVIDER=huggingface
HF_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RAG_TOP_K=5
RAG_SCORE_THRESHOLD=0.3
# Only used when RAG_EMBEDDING_PROVIDER=google (against a Google-embedded collection).
GOOGLE_EMBEDDING_MODEL=models/text-embedding-004
GOOGLE_RECIPE_MODEL=models/gemini-2.5-flash

# Host port the web UI is published on. Use 80 on a server, 5173 locally.
CLIENT_PORT=5173
