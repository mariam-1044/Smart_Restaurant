### auth-update-password — happy path
### auth: protect (any authenticated user); story: US4 / FR-012, FR-012a, FR-013
PATCH http://localhost:5000/api/auth/update-password
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "currentPassword": "oldPass1",
  "newPassword": "newPass2"
}

# expect 200
# { "success": true, "message": "password updated" }
# Subsequent /auth/login with newPass2 → 200; with oldPass1 → 401


### auth-update-password — REJECTED: wrong current password
PATCH http://localhost:5000/api/auth/update-password
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "currentPassword": "WRONG",
  "newPassword": "newPass2"
}

# expect 401
# { "success": false, "message": "current password incorrect" }
# DB password hash MUST be unchanged


### auth-update-password — REJECTED: policy violation (too short)
PATCH http://localhost:5000/api/auth/update-password
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "currentPassword": "oldPass1",
  "newPassword": "abc"
}

# expect 400
# { "success": false, "message": "password policy violation", "violations": ["min_length", "missing_digit"] }


### auth-update-password — REJECTED: policy violation (no digit)
PATCH http://localhost:5000/api/auth/update-password
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "currentPassword": "oldPass1",
  "newPassword": "abcdefghi"
}

# expect 400
# { "success": false, "message": "password policy violation", "violations": ["missing_digit"] }


### auth-update-password — REJECTED: policy violation (no letter)
PATCH http://localhost:5000/api/auth/update-password
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "currentPassword": "oldPass1",
  "newPassword": "12345678"
}

# expect 400
# { "success": false, "message": "password policy violation", "violations": ["missing_letter"] }


### auth-update-password — REJECTED: same as current
PATCH http://localhost:5000/api/auth/update-password
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "currentPassword": "oldPass1",
  "newPassword": "oldPass1"
}

# expect 400
# { "success": false, "message": "password policy violation", "violations": ["same_as_current"] }


### auth-update-password — unauthenticated
PATCH http://localhost:5000/api/auth/update-password
Content-Type: application/json

{
  "currentPassword": "oldPass1",
  "newPassword": "newPass2"
}

# expect 401
